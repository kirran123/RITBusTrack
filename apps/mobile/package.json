{
  "name": "college-bus-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:ios": "npx eas-cli build -p ios --profile preview",
    "export:web": "expo export --platform web",
    "desktop": "npx expo export -p web && electron .",
    "build:exe": "npx expo export -p web && npx -y electron-packager . \"College Bus Mobile App\" --platform=win32 --arch=x64 --out=../../dist-mobile-exe --overwrite --prune=false"
  },
  "dependencies": {
    "@college-bus/shared": "file:../../packages/shared",
    "@expo/metro": "^56.1.0",
    "@expo/metro-runtime": "~57.0.16",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "^57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "^57.0.10",
    "expo-location": "~57.0.19",
    "expo-notifications": "^57.0.21",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.4",
    "lucide-react-native": "^0.395.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.0.0",
    "babel-preset-expo": "^57.0.12",
    "metro": "^0.84.4",
    "metro-config": "^0.84.4",
    "typescript": "^5.3.3"
  },
  "private": true
}
