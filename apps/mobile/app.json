{
  "expo": {
    "name": "Bus Track",
    "slug": "bus-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.college.bustrack",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "College Bus Track needs your location to display your proximity to bus stops and calculate accurate arrival times.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "College Bus Track requires background location access for drivers to broadcast continuous bus telemetry during active trips.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.college.bustrack",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "scheme": "college-bus-track",
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "7fa1a5b8-cdfc-4637-a6d7-e389c869bb41"
      }
    }
  }
}
